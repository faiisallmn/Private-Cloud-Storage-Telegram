# Flask & JWT
SECRET_KEY=
JWT_SECRET_KEY=

# Database
DATABASE_URL=sqlite:///cloud_storage.db

# Telegram Bot
BOT_TOKEN=

# Chat ID channel/group privat untuk menyimpan file.
STORAGE_CHAT_ID=

# Telegram API Credentials
TELEGRAM_API_ID=
TELEGRAM_API_HASH=


# File Chunking
CHUNK_SIZE_BYTES=1800000000

# Upload Folder
UPLOAD_FOLDER=uploads

# CORS — origin yang diizinkan akses API
CORS_ORIGINS=http://localhost:5000

# Flask Debug Mode
FLASK_DEBUG=false
